          "text": "beta.assistants",
          "kind": "substring",
          "note": "SDK property path (client.beta.assistants)"
        },
        {
          "text": "beta.threads",
          "kind": "substring",
          "note": "SDK property path (client.beta.threads, client.beta.threads.runs)"
        },
        {
          "text": "assistant_id",
          "kind": "word",
          "note": "run parameter (runs.create(assistant_id=...))"
        },
        {
          "text": "thread_id",
