      "id": "openai-assistants-api",
      "vendor": "OpenAI",
      "name": "Assistants API",
      "sunset": "2026-08-26",
      "source_url": "https://developers.openai.com/api/docs/deprecations",
      "verified_on": "2026-08-11",
      "replacement": "Responses API and Conversations API",
      "migration": "Assistants become prompt objects that hold the model, tools and instructions; threads become conversations; runs become responses; run steps become items. openai.beta.threads.create() becomes openai.conversations.create(), and openai.beta.threads.runs.create(assistant_id=..., thread_id=...) becomes openai.responses.create(prompt={\"id\": ...}, input=[...], conversation=...). OpenAI states it will not provide an automated tool for migrating threads to conversations, so every call site has to be found and rewritten by hand.",
      "migration_url": "https://developers.openai.com/api/docs/assistants/migration",
      "notes": "Announced 2025-08-26 with one year of notice. The deprecations page names no grace period past the shutdown date.",
      "patterns": [
        { "text": "/v1/assistants", "kind": "substring", "note": "REST endpoint" },
        { "text": "/v1/threads", "kind": "substring", "note": "REST endpoint" },
        {
          "text": "beta.assistants",
          "kind": "substring",
          "note": "SDK property path (client.beta.assistants)"
        },
        {
          "text": "beta.threads",
          "kind": "substring",
          "note": "SDK property path (client.beta.threads, client.beta.threads.runs)"
        },
        {
          "text": "assistant_id",
          "kind": "word",
          "note": "run parameter (runs.create(assistant_id=...))"
        },
        {
          "text": "thread_id",
          "kind": "word",
          "note": "run parameter (runs.create(thread_id=...))"
        }
